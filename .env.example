# === Anthropic ===
ANTHROPIC_API_KEY=sk-ant-...

# === Evolution API ===
# URL interna que o backend usa (nome do serviço no compose)
EVOLUTION_API_URL=http://evolution-api:8080
# Chave que protege a Evolution API. Gere algo forte: openssl rand -hex 32
EVOLUTION_API_KEY=troque-isto-por-uma-chave-forte
# Nome da instância que voce vai criar no manager
EVOLUTION_INSTANCE_NAME=obstetra
# URL publica do backend (usada pela Evolution para mandar webhook)
# Local: http://backend:8000  |  Railway: https://backend-producao.up.railway.app
BACKEND_PUBLIC_URL=http://backend:8000

# === Dra. Leiza ===
# Numero da doutora em formato internacional sem + (ex: 5511999999999)
DOCTOR_PHONE_NUMBER=
DOCTOR_NAME=Dra. Leiza

# === Banco da Evolution API (Postgres) ===
POSTGRES_USER=evolution
POSTGRES_PASSWORD=troque-isto-tambem
POSTGRES_DB=evolution

# === Backend (opcional) ===
# Logs mais verbosos em dev
LOG_LEVEL=INFO
